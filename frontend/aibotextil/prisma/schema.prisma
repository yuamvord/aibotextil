generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model aibotextil {
  Codigo_Fabrica String?
  Codigo_Aibo    String?
  Nombre_Tela    String?
  Nombre_Corto   String?
  Peso           String?
  Ancho          String?
  Composicion    String?
  Url_Imagen     String?

  @@ignore
}

model Categorias {
  Id_Categoria   Int              @id @default(autoincrement())
  Nombre         String
  Slug           String           @unique
  Tela_Categoria Tela_Categoria[]
}

model Tela_Categoria {
  Id_Tela      Int
  Id_Categoria Int
  Telas        Telas      @relation(fields: [Id_Tela], references: [Id_Tela], onUpdate: NoAction)
  Categorias   Categorias @relation(fields: [Id_Categoria], references: [Id_Categoria], onUpdate: NoAction)

  @@id([Id_Tela, Id_Categoria])
}

model tela_imagenes {
  Id_Tela    Int
  Imagen_Url String
  Orden      Int?
  Telas      Telas  @relation(fields: [Id_Tela], references: [Id_Tela])

  @@id([Id_Tela, Imagen_Url])
}

model Telas {
  Id_Tela        Int              @id @default(autoincrement())
  Codigo_Fabrica String           @db.NVarChar(70)
  Codigo_Aibo    String           @unique @db.NVarChar(70)
  Nombre_Tela    String           @db.NVarChar(255)
  Nombre_Corto   String           @db.NVarChar(255)
  Peso           String           @db.NVarChar(50)
  Ancho          String           @db.NVarChar(50)
  Composicion    String           @db.NVarChar(255)
  Url_Imagen     String?          @db.NVarChar(Max)
  Sublimado      String?          @default("Sublimable") @db.NVarChar(50)

  // RELACIONES
  Tela_Categoria Tela_Categoria[]
  tela_imagenes  tela_imagenes[]
  
  // Conexión con la tabla puente
  Telas_Desc     Telas_Desc[]
}

// ... (Tus otros modelos) ...

model Telas_Desc {
  // Esta es la tabla puente (solo IDs)
  Id_Tela Int
  Id_Desc Int
  
  // Relaciones
  Telas       Telas       @relation(fields: [Id_Tela], references: [Id_Tela])
  Descripcion Descripcion @relation(fields: [Id_Desc], references: [Id_Desc]) // Apunta al modelo de abajo

  @@id([Id_Tela, Id_Desc]) // Llave compuesta
}

model Descripcion {
  Id_Desc     Int          @id @default(autoincrement())
  
  // CORRECCIÓN AQUÍ: Se llama Tag en la BD
  Tag         String       @db.NVarChar(Max) 

  // Relación inversa
  Telas_Desc  Telas_Desc[]
}