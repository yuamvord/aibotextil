generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model aibotextil {
  Codigo_Fabrica String? @db.VarChar(50)
  Codigo_Aibo    String? @db.VarChar(50)
  Nombre_Tela    String? @db.VarChar(50)
  Nombre_Corto   String? @db.VarChar(50)
  Peso           String? @db.VarChar(50)
  Ancho          String? @db.VarChar(50)
  Composicion    String? @db.VarChar(50)
  Url_Imagen     String? @db.VarChar(50)

  @@ignore
}

model Categorias {
  Id_Categoria   Int              @id(map: "PK__Categori__CB90334934EC69BB") @default(autoincrement())
  Nombre         String           @db.NVarChar(255)
  Slug           String           @unique(map: "UQ__Categori__BC7B5FB669889057") @db.NVarChar(255)
  Tela_Categoria Tela_Categoria[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Tela_Categoria {
  Id_Tela      Int
  Id_Categoria Int
  Telas        Telas      @relation(fields: [Id_Tela], references: [Id_Tela], onUpdate: NoAction, map: "FK__Tela_Cate__Id_Ca__71D1E811")
  Categorias   Categorias @relation(fields: [Id_Categoria], references: [Id_Categoria], onUpdate: NoAction, map: "FK__Tela_Cate__Id_Ca__72C60C4A")

  @@id([Id_Tela, Id_Categoria])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model tela_imagenes {
  Id_Tela    Int
  Imagen_Url String @db.NVarChar(4000)
  Orden      Int?

  Telas      Telas     @relation(fields: [Id_Tela], references: [Id_Tela])
  @@id([Id_Tela, Imagen_Url])
}

model Telas {
  Id_Tela        Int              @id(map: "PK__Telas__075963A7E6E2A0CB") @default(autoincrement())
  Codigo_Fabrica String           @db.NVarChar(70)
  Codigo_Aibo    String           @unique(map: "UQ__Telas__664CBA0313A3BF45") @db.NVarChar(70)
  Nombre_Tela    String           @db.NVarChar(255)
  Nombre_Corto   String           @db.NVarChar(255)
  Peso           String           @db.NVarChar(50)
  Ancho          String           @db.NVarChar(50)
  Composicion    String           @db.NVarChar(255)
  Url_Imagen     String           @db.NVarChar(Max)
  Tela_Categoria Tela_Categoria[] 
  tela_imagenes  tela_imagenes[]
}
